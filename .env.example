# Copy to .env (gitignored) and fill in. The server's command loads it:
#   sh -c 'set -a; . <repo>/.env; exec <repo>/_build/prod/rel/air/bin/air start'
# The scripts in scripts/ read it too.

# Private data: tenants.json, ringback.wav, clips/, calls/, memory/, usage.jsonl
AIR_DATA=/path/to/loom-air/data
# infer-gw, and the file holding Loom Air's key for it
AIR_GW_URL=http://<infer-gw host>:8090
AIR_GW_KEY_FILE=/path/to/gw-key
# HMAC key of the shared app login cookie (app-kit's ~/.config/app-auth/secret)
AIR_APP_SECRET=/path/to/app-auth/secret

# Optional, with their defaults
# PORT=5310
# AIR_REGION=us-west-2
# AIR_MODEL=us.anthropic.claude-sonnet-5-5
# AIR_THINKING=adaptive           # the operator's thinking type (Haiku 5.5 also takes disabled)
# AIR_EFFORT=low                  # output_config.effort
# AIR_MEMORY_MODEL=us.anthropic.claude-opus-5-5
# AIR_GW_MODEL=step-audio-editx
# AIR_WS=ws://localhost:5000/apps/loom-air/ws   (scripts/ws-test.py)
